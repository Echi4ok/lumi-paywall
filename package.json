{
  "name": "lumi-paywall",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "db:migrate": "node --env-file-if-exists=.env --experimental-strip-types scripts/migrate.ts",
    "db:check": "npm run db:migrate -- --check",
    "check:runtime": "node scripts/check-runtime.mjs",
    "compare:design": "node scripts/compare-design.mjs",
    "test:e2e": "playwright test",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "h3": "^1.15.11",
    "nuxt": "4.6.1",
    "pg": "^8.23.1",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.14",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.7.2",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.12.0",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.0.2",
    "pixelmatch": "^8.0.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.1.1"
  },
  "overrides": {
    "simple-git": "4.0.2"
  }
}
