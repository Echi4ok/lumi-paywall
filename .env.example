# Local `npm run dev` works without secrets and persists to .data/lumi/.
# Production requires external Postgres and RATE_LIMIT_SECRET.
# Never expose these values via public runtimeConfig.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@DIRECT_HOST/DATABASE?sslmode=require
# DATABASE_DRIVER=neon
# Use DATABASE_DRIVER=postgres for a standard TCP PostgreSQL server.
# RATE_LIMIT_SECRET=<generate 32 random bytes, keep identical across deployment instances>

# Optional absolute/relative directory for local development only:
# LOCAL_DATABASE_PATH=.data/lumi

# Optional canonical browser origin for an explicit CSRF boundary behind a proxy:
# APP_ORIGIN=https://your-project.vercel.app
